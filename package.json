{
  "scripts": {
    "start": "cd app && node server.js",
    "db:create": "psql -U postgres -d postgres -f create.sql",
    "db:schema": "psql -U postgres -d Tag-A-Long -f schema.sql",
    "db:seed": "psql -U postgres -d Tag-A-Long -f seed.sql",
    "setup": "npm run db:create && npm run db:schema && npm run db:seed"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}